# Copy to .env and fill in. .env is git-ignored. TESTNET ONLY: never put a key that holds real funds here.
# Generate a throwaway key with:
#   node --input-type=module -e "import {generatePrivateKey} from 'viem/accounts'; console.log(generatePrivateKey())"
# Fund it at https://hub.arkiv.network/faucet (Tiramisu, chain 7738577).

# Funds the seed wallets and is the reporter in the e2e test.
REPORTER_PRIVATE_KEY=
# Second and third wallets for the e2e corroboration test.
WITNESS_A_PRIVATE_KEY=
WITNESS_B_PRIVATE_KEY=
# Publishes the synthetic shop registry. Must match DEFAULT_REGISTRY in packages/tolmol-sdk/src/constants.ts
REGISTRY_PRIVATE_KEY=
# Gas-drip relayer key (apps/relayer). Holds a little test GLM; only sends drips.
RELAYER_PRIVATE_KEY=
# Optional relayer settings
ALLOWED_ORIGINS=*
IP_SALT=change-me
# Header that carries the visitor's IP AS SET BY THE PLATFORM (Vercel: x-real-ip, set automatically in api/index.ts;
# Cloudflare: cf-connecting-ip, set in worker.ts). Never a header the visitor can send, or the per-IP limits can be bypassed.
IP_HEADER=

# Card verifier (POST /verify on the relayer host; its own wallet, named by the registry's tolmol.verifier entity)
VERIFIER_PRIVATE_KEY=
# Secret for card_tag = HMAC(secret, card serial); at least 32 characters. Never put it on Arkiv.
CARD_TAG_SECRET=
# Scripts only: the TEST card issuer key that signs the synthetic test cards (scripts/make-test-cards.ts etc.)
TEST_ISSUER_PRIVATE_KEY=
# Scripts only: demo dealer and official wallets (scripts/seed-answers.ts, scripts/seed-officials.ts)
DEMO_DEALER_PRIVATE_KEY=
DEMO_OFFICIAL_PRIVATE_KEY=

# Web app build (apps/web): public URL of the relayer, or leave empty to show the faucet link only.
VITE_RELAYER_URL=
