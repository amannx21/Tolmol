# Copy to .env and fill in. .env is git-ignored. TESTNET ONLY: never put a key that holds real funds here.
# Generate a throwaway key with:
#   node --input-type=module -e "import {generatePrivateKey} from 'viem/accounts'; console.log(generatePrivateKey())"
# Fund it at https://hub.arkiv.network/faucet (Tiramisu, chain 7738577).

# Funds the seed wallets and is the reporter in the e2e test.
REPORTER_PRIVATE_KEY=
# Second and third wallets for the e2e corroboration test.
WITNESS_A_PRIVATE_KEY=
WITNESS_B_PRIVATE_KEY=
# Publishes the synthetic shop registry. Must match DEFAULT_REGISTRY in packages/tolmol-sdk/src/constants.ts
REGISTRY_PRIVATE_KEY=
# Gas-drip relayer key (apps/relayer). Holds a little test GLM; only sends drips.
RELAYER_PRIVATE_KEY=
# Optional relayer settings
ALLOWED_ORIGINS=*
IP_SALT=change-me

# Web app build (apps/web): public URL of the relayer, or leave empty to show the faucet link only.
VITE_RELAYER_URL=
