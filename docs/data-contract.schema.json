{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/amannx21/Tolmol/blob/main/docs/data-contract.schema.json",
  "title": "Tolmol data contract (Arkiv entities, schema_version 1)",
  "description": "Machine-readable form of arkiv/schema.md. Each object describes the ATTRIBUTES of one Arkiv entity type as returned by @arkiv-network/sdk (name -> {type, value}). Arkiv Tiramisu, chain 7738577. All data is synthetic. Trust rules (dedupe, different-device witnesses, reporter-only withdrawals, registry-only shops) are in arkiv/schema.md.",
  "$defs": {
    "str": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "str"
        },
        "value": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "i32": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "i32"
        },
        "value": {
          "type": "integer"
        }
      }
    },
    "u64": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "u64"
        },
        "value": {
          "description": "bigint in the SDK, hex string in raw JSON-RPC"
        }
      }
    },
    "bool": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "bool"
        },
        "value": {
          "type": "boolean"
        }
      }
    },
    "key": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "key"
        },
        "value": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        }
      }
    },
    "project": {
      "allOf": [
        {
          "$ref": "#/$defs/str"
        },
        {
          "properties": {
            "value": {
              "const": "tolmol"
            }
          }
        }
      ]
    },
    "schemaVersion": {
      "allOf": [
        {
          "$ref": "#/$defs/i32"
        },
        {
          "properties": {
            "value": {
              "const": 1
            }
          }
        }
      ]
    },
    "shopId": {
      "allOf": [
        {
          "$ref": "#/$defs/str"
        },
        {
          "properties": {
            "value": {
              "pattern": "^SYN-[A-Z]{2}-[0-9]{4}$"
            }
          }
        }
      ]
    },
    "state": {
      "allOf": [
        {
          "$ref": "#/$defs/str"
        },
        {
          "properties": {
            "value": {
              "pattern": "^[A-Z]{2}$"
            }
          }
        }
      ]
    },
    "month": {
      "allOf": [
        {
          "$ref": "#/$defs/str"
        },
        {
          "properties": {
            "value": {
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
            }
          }
        }
      ]
    },
    "item": {
      "allOf": [
        {
          "$ref": "#/$defs/str"
        },
        {
          "properties": {
            "value": {
              "enum": [
                "rice",
                "wheat",
                "millet",
                "total",
                "meal_days",
                "wage_inr"
              ]
            }
          }
        }
      ],
      "description": "rice/wheat/millet/total: ration, amounts in grams. meal_days: school meals, amounts in school days. wage_inr: MGNREGA wages, amounts in whole rupees."
    },
    "grams": {
      "allOf": [
        {
          "$ref": "#/$defs/i32"
        },
        {
          "properties": {
            "value": {
              "minimum": 0,
              "maximum": 100000
            }
          }
        }
      ]
    },
    "scheme": {
      "description": "The scheme of a non-ration outlet or report. Absent on ration shops and ration reports (= pds).",
      "allOf": [
        {
          "$ref": "#/$defs/str"
        },
        {
          "properties": {
            "value": {
              "enum": [
                "mdm",
                "nrega"
              ]
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "title": "tolmol.shop",
      "description": "Synthetic registry. Trusted only when $creator = 0x6DBf6A36E27d814c58A05312913DCEEfc0dAe221. readonly + permissionlessExtension, 180 days. Payload: JSON {label_en, label_hi, synthetic}.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "type",
        "schema_version",
        "shop_id",
        "state",
        "district",
        "synthetic"
      ],
      "properties": {
        "project": {
          "$ref": "#/$defs/project"
        },
        "type": {
          "allOf": [
            {
              "$ref": "#/$defs/str"
            },
            {
              "properties": {
                "value": {
                  "const": "tolmol.shop"
                }
              }
            }
          ]
        },
        "schema_version": {
          "$ref": "#/$defs/schemaVersion"
        },
        "shop_id": {
          "$ref": "#/$defs/shopId"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "district": {
          "$ref": "#/$defs/str"
        },
        "synthetic": {
          "allOf": [
            {
              "$ref": "#/$defs/bool"
            },
            {
              "properties": {
                "value": {
                  "const": true
                }
              }
            }
          ]
        }
      }
    },
    {
      "title": "tolmol.outlet",
      "description": "An outlet of another scheme on the same ledger: a school (scheme mdm, school meals) or a gram panchayat (scheme nrega, MGNREGA wages). Same attributes and payload as tolmol.shop, plus scheme. Trusted only from the registry creator.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "type",
        "schema_version",
        "shop_id",
        "state",
        "district",
        "synthetic",
        "scheme"
      ],
      "properties": {
        "project": {
          "$ref": "#/$defs/project"
        },
        "type": {
          "allOf": [
            {
              "$ref": "#/$defs/str"
            },
            {
              "properties": {
                "value": {
                  "const": "tolmol.outlet"
                }
              }
            }
          ]
        },
        "schema_version": {
          "$ref": "#/$defs/schemaVersion"
        },
        "shop_id": {
          "$ref": "#/$defs/shopId"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "district": {
          "$ref": "#/$defs/str"
        },
        "synthetic": {
          "allOf": [
            {
              "$ref": "#/$defs/bool"
            },
            {
              "properties": {
                "value": {
                  "const": true
                }
              }
            }
          ]
        },
        "scheme": {
          "$ref": "#/$defs/scheme"
        }
      }
    },
    {
      "title": "tolmol.report",
      "description": "One device's claim for one shop, month and grain. Created readonly (+ permissionlessExtension unless the reporter opted out) and transferred to 0x...dEaD in the same batch. Empty payload. Readers recompute shortfall_g, shortfall_bp and month_num and drop entities that disagree. Reports for another scheme carry scheme (mdm with item meal_days, nrega with item wage_inr) and that scheme's issue flags; readers drop a report whose scheme and item disagree.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "type",
        "schema_version",
        "shop_id",
        "state",
        "district",
        "month",
        "month_num",
        "item",
        "entitled_g",
        "received_g",
        "shortfall_g",
        "shortfall_bp",
        "reported_at",
        "synthetic"
      ],
      "properties": {
        "project": {
          "$ref": "#/$defs/project"
        },
        "type": {
          "allOf": [
            {
              "$ref": "#/$defs/str"
            },
            {
              "properties": {
                "value": {
                  "const": "tolmol.report"
                }
              }
            }
          ]
        },
        "schema_version": {
          "$ref": "#/$defs/schemaVersion"
        },
        "shop_id": {
          "$ref": "#/$defs/shopId"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "district": {
          "$ref": "#/$defs/str"
        },
        "month": {
          "$ref": "#/$defs/month"
        },
        "month_num": {
          "$ref": "#/$defs/i32",
          "description": "YYYYMM as a number, for range queries"
        },
        "item": {
          "$ref": "#/$defs/item"
        },
        "entitled_g": {
          "$ref": "#/$defs/grams"
        },
        "received_g": {
          "$ref": "#/$defs/grams"
        },
        "shortfall_g": {
          "$ref": "#/$defs/grams"
        },
        "shortfall_bp": {
          "allOf": [
            {
              "$ref": "#/$defs/i32"
            },
            {
              "properties": {
                "value": {
                  "minimum": 0,
                  "maximum": 10000
                }
              }
            }
          ]
        },
        "issues": {
          "allOf": [
            {
              "$ref": "#/$defs/i32"
            },
            {
              "properties": {
                "value": {
                  "minimum": 0,
                  "maximum": 127
                }
              }
            }
          ],
          "description": "Optional bitmask of the first 7 issue flags: 1 charged_money, 2 auth_failed, 4 thumb_no_grain, 8 shop_closed, 16 bad_quality, 32 portability_refused, 64 no_receipt. Absent = 0."
        },
        "reported_at": {
          "$ref": "#/$defs/u64",
          "description": "Start of the UTC day, ms (reports after 2026-10-14); earlier reports carry the device ms time"
        },
        "synthetic": {
          "$ref": "#/$defs/bool"
        },
        "issues2": {
          "allOf": [
            {
              "$ref": "#/$defs/i32"
            },
            {
              "properties": {
                "value": {
                  "minimum": 1,
                  "maximum": 1023
                }
              }
            }
          ],
          "description": "Optional (since 2026-10-15), written only when non-zero: the further issue flags, shifted down by 7: 1 slip_mismatch, 2 no_weighing, 4 tied_sale, 8 card_kept, 16 no_board, 32 told_lapsed, 64 many_trips, 128 wrong_grain, 256 threatened, 512 member_left_out. Readers that only know `issues` still count the report."
        },
        "scheme": {
          "$ref": "#/$defs/scheme"
        }
      }
    },
    {
      "title": "tolmol.witness",
      "description": "'I also got less at this shop this month' from a different device. Counted once per $creator, never from the report's own creator. readonly + permissionlessExtension, transferred to 0x...dEaD. Empty payload.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "type",
        "schema_version",
        "report_key",
        "shop_id",
        "state",
        "month",
        "item",
        "reported_at",
        "synthetic"
      ],
      "properties": {
        "project": {
          "$ref": "#/$defs/project"
        },
        "type": {
          "allOf": [
            {
              "$ref": "#/$defs/str"
            },
            {
              "properties": {
                "value": {
                  "const": "tolmol.witness"
                }
              }
            }
          ]
        },
        "schema_version": {
          "$ref": "#/$defs/schemaVersion"
        },
        "report_key": {
          "$ref": "#/$defs/key"
        },
        "shop_id": {
          "$ref": "#/$defs/shopId"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "month": {
          "$ref": "#/$defs/month"
        },
        "item": {
          "$ref": "#/$defs/item"
        },
        "reported_at": {
          "$ref": "#/$defs/u64"
        },
        "synthetic": {
          "$ref": "#/$defs/bool"
        }
      }
    },
    {
      "title": "tolmol.correction",
      "description": "Withdrawal of a report. Honoured ONLY when its $creator equals the report's $creator. readonly, transferred to 0x...dEaD, lives until report.createdAt + 365 days. Empty payload.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "type",
        "schema_version",
        "report_key",
        "shop_id",
        "state",
        "month",
        "action",
        "reported_at",
        "synthetic"
      ],
      "properties": {
        "project": {
          "$ref": "#/$defs/project"
        },
        "type": {
          "allOf": [
            {
              "$ref": "#/$defs/str"
            },
            {
              "properties": {
                "value": {
                  "const": "tolmol.correction"
                }
              }
            }
          ]
        },
        "schema_version": {
          "$ref": "#/$defs/schemaVersion"
        },
        "report_key": {
          "$ref": "#/$defs/key"
        },
        "shop_id": {
          "$ref": "#/$defs/shopId"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "month": {
          "$ref": "#/$defs/month"
        },
        "action": {
          "allOf": [
            {
              "$ref": "#/$defs/str"
            },
            {
              "properties": {
                "value": {
                  "const": "withdraw"
                }
              }
            }
          ]
        },
        "reported_at": {
          "$ref": "#/$defs/u64"
        },
        "synthetic": {
          "$ref": "#/$defs/bool"
        }
      }
    },
    {
      "title": "tolmol.verifier",
      "description": "A wallet the registry trusts to verify card holders. Trusted only when $creator = the registry wallet. readonly, 180 days, extended while the verifier stays trusted (letting it expire revokes it). Empty payload.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "type",
        "schema_version",
        "verifier",
        "synthetic"
      ],
      "properties": {
        "project": {
          "$ref": "#/$defs/project"
        },
        "type": {
          "allOf": [
            {
              "$ref": "#/$defs/str"
            },
            {
              "properties": {
                "value": {
                  "const": "tolmol.verifier"
                }
              }
            }
          ]
        },
        "schema_version": {
          "$ref": "#/$defs/schemaVersion"
        },
        "verifier": {
          "allOf": [
            {
              "$ref": "#/$defs/str"
            },
            {
              "properties": {
                "value": {
                  "pattern": "^0x[0-9a-f]{40}$"
                }
              }
            }
          ]
        },
        "synthetic": {
          "allOf": [
            {
              "$ref": "#/$defs/bool"
            },
            {
              "properties": {
                "value": {
                  "const": true
                }
              }
            }
          ]
        }
      }
    },
    {
      "title": "tolmol.attestation",
      "description": "'This device is a verified card holder at shop X.' Counted only when $creator is a live verifier named by the registry; one device per card_tag (earliest wins). card_tag = HMAC-SHA256(verifier secret, card serial): no card data. readonly, owned by the verifier, 365 days. Empty payload.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "type",
        "schema_version",
        "device",
        "state",
        "shop_id",
        "card_tag",
        "method",
        "verified_on",
        "synthetic"
      ],
      "properties": {
        "project": {
          "$ref": "#/$defs/project"
        },
        "type": {
          "allOf": [
            {
              "$ref": "#/$defs/str"
            },
            {
              "properties": {
                "value": {
                  "const": "tolmol.attestation"
                }
              }
            }
          ]
        },
        "schema_version": {
          "$ref": "#/$defs/schemaVersion"
        },
        "device": {
          "allOf": [
            {
              "$ref": "#/$defs/str"
            },
            {
              "properties": {
                "value": {
                  "pattern": "^0x[0-9a-f]{40}$"
                }
              }
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "shop_id": {
          "$ref": "#/$defs/shopId"
        },
        "card_tag": {
          "$ref": "#/$defs/key"
        },
        "method": {
          "allOf": [
            {
              "$ref": "#/$defs/str"
            },
            {
              "properties": {
                "value": {
                  "enum": [
                    "test_card",
                    "camp"
                  ]
                }
              }
            }
          ]
        },
        "verified_on": {
          "$ref": "#/$defs/u64",
          "description": "start of the UTC day, ms"
        },
        "synthetic": {
          "$ref": "#/$defs/bool"
        },
        "role": {
          "allOf": [
            {
              "$ref": "#/$defs/str"
            },
            {
              "properties": {
                "value": {
                  "enum": [
                    "card_holder",
                    "dealer",
                    "official"
                  ]
                }
              }
            }
          ],
          "description": "card_holder (ration card), dealer (the outlet's operator: fair-price-shop licence FPS, school head teacher ID SCH, or gram panchayat employment assistant ID GPO) or official (official ID, GOV; jurisdiction = the district of shop_id). Absent on attestations made before 2026-10-15 = card_holder."
        }
      }
    },
    {
      "title": "tolmol.response",
      "description": "A shop's answer to a report, from a fixed list (no free text). Counted only when $creator is a device with a dealer attestation for this shop_id; one per (report, action). readonly, transferred to 0x...dEaD, lives until the report's createdAt + 365 days. Empty payload.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "type",
        "schema_version",
        "report_key",
        "shop_id",
        "state",
        "month",
        "reported_at",
        "synthetic",
        "action"
      ],
      "properties": {
        "project": {
          "$ref": "#/$defs/project"
        },
        "type": {
          "allOf": [
            {
              "$ref": "#/$defs/str"
            },
            {
              "properties": {
                "value": {
                  "const": "tolmol.response"
                }
              }
            }
          ]
        },
        "schema_version": {
          "$ref": "#/$defs/schemaVersion"
        },
        "report_key": {
          "$ref": "#/$defs/key"
        },
        "shop_id": {
          "$ref": "#/$defs/shopId"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "month": {
          "$ref": "#/$defs/month"
        },
        "reported_at": {
          "$ref": "#/$defs/u64"
        },
        "synthetic": {
          "$ref": "#/$defs/bool"
        },
        "action": {
          "allOf": [
            {
              "$ref": "#/$defs/str"
            },
            {
              "properties": {
                "value": {
                  "enum": [
                    "full_quantity",
                    "stock_arrived",
                    "scale_checked",
                    "open_as_displayed",
                    "board_updated",
                    "receipt_given",
                    "money_returned",
                    "auth_help",
                    "quality_replaced",
                    "portability_served",
                    "no_tied_sale",
                    "card_returned",
                    "respectful_service",
                    "disputed",
                    "meals_resumed",
                    "menu_followed",
                    "kitchen_cleaned",
                    "equal_seating",
                    "no_child_labour",
                    "wages_paid",
                    "job_card_returned",
                    "work_allotted",
                    "site_facilities"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    {
      "title": "tolmol.followup",
      "description": "The reporter's word on whether the shop fixed it. Counted only from the report's own $creator; the latest one wins. readonly, transferred to 0x...dEaD, lives until the report's createdAt + 365 days. Empty payload.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "type",
        "schema_version",
        "report_key",
        "shop_id",
        "state",
        "month",
        "reported_at",
        "synthetic",
        "status"
      ],
      "properties": {
        "project": {
          "$ref": "#/$defs/project"
        },
        "type": {
          "allOf": [
            {
              "$ref": "#/$defs/str"
            },
            {
              "properties": {
                "value": {
                  "const": "tolmol.followup"
                }
              }
            }
          ]
        },
        "schema_version": {
          "$ref": "#/$defs/schemaVersion"
        },
        "report_key": {
          "$ref": "#/$defs/key"
        },
        "shop_id": {
          "$ref": "#/$defs/shopId"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "month": {
          "$ref": "#/$defs/month"
        },
        "reported_at": {
          "$ref": "#/$defs/u64"
        },
        "synthetic": {
          "$ref": "#/$defs/bool"
        },
        "status": {
          "allOf": [
            {
              "$ref": "#/$defs/str"
            },
            {
              "properties": {
                "value": {
                  "enum": [
                    "fixed",
                    "not_fixed"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    {
      "title": "tolmol.action",
      "description": "An official action on a shop, from a fixed list grounded in the TPDS (Control) Order 2015 (cl. 10(7), 11(1), 13). Counted only when $creator is a device with an 'official' attestation whose shop is in the same district as this shop (from the registry); one per (shop, action). readonly, transferred to 0x...dEaD, 365 days. Empty payload.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "type",
        "schema_version",
        "shop_id",
        "state",
        "district",
        "action",
        "reported_at",
        "synthetic"
      ],
      "properties": {
        "project": {
          "$ref": "#/$defs/project"
        },
        "type": {
          "allOf": [
            {
              "$ref": "#/$defs/str"
            },
            {
              "properties": {
                "value": {
                  "const": "tolmol.action"
                }
              }
            }
          ]
        },
        "schema_version": {
          "$ref": "#/$defs/schemaVersion"
        },
        "shop_id": {
          "$ref": "#/$defs/shopId"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "district": {
          "$ref": "#/$defs/str"
        },
        "action": {
          "allOf": [
            {
              "$ref": "#/$defs/str"
            },
            {
              "properties": {
                "value": {
                  "enum": [
                    "inspection_ordered",
                    "inspected_shortage_found",
                    "inspected_no_issue",
                    "show_cause_notice",
