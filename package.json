{
  "name": "tolmol-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Tolmol: a community-witnessed, tamper-evident ledger of ration (PDS) shortfalls on Arkiv",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w tolmol-sdk && npm run build -w tolmol-web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --project unit",
    "test:e2e": "node --env-file=.env ./node_modules/vitest/vitest.mjs run --project e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "node --env-file=.env --import tsx scripts/seed.ts",
    "tolmol": "node packages/tolmol-sdk/dist/cli.js"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "3.2.7"
  }
}
